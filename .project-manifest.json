  "workflows": [
    {
      "id": "dose",
      "name": "积分与断档范围",
      "entry": "POST /indicator/dose",
      "success": "逐时间段输出精确剂量或上下界",
      "failure": "温度超校准定义域时不外推",
      "verification": "python3 -B -m thermal.example /indicator/dose",
      "module_ids": [
        "curve",
        "exposure",
        "http_api"
      ],
      "steps": [
        "解析项目专用输入并验证前置条件",
        "逐时间段输出精确剂量或上下界"
      ]
    },
    {
      "id": "disposition",
      "name": "试验剂量判读",
      "entry": "POST /indicator/disposition",
      "success": "给出确定达到、未达或需复核",
      "failure": "界限跨阈值时不强判",
